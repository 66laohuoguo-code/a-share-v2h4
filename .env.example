# These are fallback values for tools that do not pass costs explicitly.
# V2H4 backtests and weekly rebalancing use broker_commission_rate and
# broker_minimum_commission from the selected strategy JSON instead.
# PowerShell example for the current process:
# $env:A_SHARE_BROKER_COMMISSION_RATE="0.0003"
# $env:A_SHARE_BROKER_MIN_COMMISSION="5"

A_SHARE_BROKER_COMMISSION_RATE=0
A_SHARE_BROKER_MIN_COMMISSION=0
